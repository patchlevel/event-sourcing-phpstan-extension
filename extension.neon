parameters:
	patchlevelEventSourcing:
		propertyInitialization: true
		unusedProperty: true
		writeOnlyProperty: true
		noRecordThatWhenApplying: true
		noStateWriteWhenNotApplying: true
		analyser: false

parametersSchema:
	patchlevelEventSourcing: structure([
		propertyInitialization: bool()
		unusedProperty: bool()
		writeOnlyProperty: bool()
		noRecordThatWhenApplying: bool()
		noStateWriteWhenNotApplying: bool()
		analyser: bool()
	])

conditionalTags:
	Patchlevel\EventSourcingPHPStanExtension\AggregateRootExtension:
		phpstan.properties.readWriteExtension: %patchlevelEventSourcing.propertyInitialization%
	Patchlevel\EventSourcingPHPStanExtension\UnusedPropertyRule:
		phpstan.rules.rule: %patchlevelEventSourcing.unusedProperty%
	Patchlevel\EventSourcingPHPStanExtension\WriteOnlyPropertyRule:
		phpstan.rules.rule: %patchlevelEventSourcing.writeOnlyProperty%
	Patchlevel\EventSourcingPHPStanExtension\DontRecordWhenApplyingExtension:
		phpstan.restrictedMethodUsageExtension: %patchlevelEventSourcing.noRecordThatWhenApplying%
	Patchlevel\EventSourcingPHPStanExtension\DontWriteStateWhenNotApplyingRule:
		phpstan.rules.rule: %patchlevelEventSourcing.noStateWriteWhenNotApplying%
	Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\AggregateCollector:
		phpstan.collector: %patchlevelEventSourcing.analyser%
	Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\EventCollector:
		phpstan.collector: %patchlevelEventSourcing.analyser%
	Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\SubscriberCollector:
		phpstan.collector: %patchlevelEventSourcing.analyser%
	Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\ProjectionCollector:
		phpstan.collector: %patchlevelEventSourcing.analyser%
	Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\HandlerCollector:
		phpstan.collector: %patchlevelEventSourcing.analyser%
	Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\ControllerCollector:
		phpstan.collector: %patchlevelEventSourcing.analyser%
	Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\CallCollector:
		phpstan.collector: %patchlevelEventSourcing.analyser%

services:
	-
		class: Patchlevel\EventSourcingPHPStanExtension\AggregateRootExtension

	-
		class: Patchlevel\EventSourcingPHPStanExtension\UnusedPropertyRule

	-
		class: Patchlevel\EventSourcingPHPStanExtension\WriteOnlyPropertyRule

	-
		class: Patchlevel\EventSourcingPHPStanExtension\DontRecordWhenApplyingExtension
		arguments:
			parser: @defaultAnalysisParser

	-
		class: Patchlevel\EventSourcingPHPStanExtension\DontWriteStateWhenNotApplyingRule

	-
		class: Patchlevel\EventSourcingPHPStanExtension\DecisionExtension
		tags:
			- phpstan.broker.dynamicMethodReturnTypeExtension

	-
		class: Patchlevel\EventSourcingPHPStanExtension\ProjectionBuilderExtension
		tags:
			- phpstan.broker.dynamicMethodReturnTypeExtension

	-
		class: Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\AggregateCollector

	-
		class: Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\EventCollector

	-
		class: Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\SubscriberCollector

	-
		class: Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\ProjectionCollector

	-
		class: Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\HandlerCollector

	-
		class: Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\ControllerCollector

	-
		class: Patchlevel\EventSourcingPHPStanExtension\Analyser\Collector\CallCollector

	errorFormatter.eventSourcingJson:
		class: Patchlevel\EventSourcingPHPStanExtension\Analyser\JsonFormatter
		arguments:
			enabled: %patchlevelEventSourcing.analyser%
			fallbackFormatter: @errorFormatter.table

	errorFormatter.eventSourcingGraphviz:
		class: Patchlevel\EventSourcingPHPStanExtension\Analyser\GraphvizFormatter
		arguments:
			enabled: %patchlevelEventSourcing.analyser%
			fallbackFormatter: @errorFormatter.table
